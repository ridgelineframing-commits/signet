/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Never let the CDN edge-cache the downloadable APK. Without this, Cloudflare
# pins the first-served bytes at the edge and keeps handing them out even after
# a new APK is deployed — so a rebuilt app appears "not updated" at the public
# URL until the cache is manually purged. no-store forces every request to hit
# the current asset.
/download/*
  Cache-Control: no-store
