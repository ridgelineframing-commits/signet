{
  "name": "signet",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "productName": "Signet PDF Editor",
  "author": "Ridgeline Framing",
  "description": "Browser-first PDF editor with optional self-hosted e-signature workflows on Cloudflare Workers, D1, R2, and Resend.",
  "scripts": {
    "test": "node --test",
    "desktop:start": "node desktop/build-icon.mjs && electron-forge start",
    "desktop:package": "node desktop/build-icon.mjs && electron-forge package --platform=win32 --arch=x64",
    "desktop:make": "node desktop/build-icon.mjs && electron-forge make --platform=win32 --arch=x64",
    "desktop:zip": "node desktop/build-icon.mjs && electron-forge make --platform=win32 --arch=x64 --targets @electron-forge/maker-zip",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute signet-db --file=./schema.sql --remote",
    "db:migrate:local": "wrangler d1 execute signet-db --file=./schema.sql --local",
    "db:migrate:otp": "wrangler d1 execute signet-db --file=./migrations/001_add_otp.sql --remote",
    "tail": "wrangler tail"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "hono": "^4.6.0",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@fontsource/hanken-grotesk": "^5.2.8",
    "@tesseract.js-data/eng": "^1.0.0",
    "electron": "^43.2.0",
    "pdfjs-dist": "^6.1.200",
    "tesseract.js": "^5.1.1",
    "tesseract.js-core": "^5.1.1",
    "wrangler": "^4.111.0"
  }
}
